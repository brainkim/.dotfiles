# Terminal.app's "Clear Dark" profile
background = #191d27
foreground = #e0e0e0
bold-color = #ededed
selection-background = #273d4c
selection-foreground = #e0e0e0
palette = 0=#35424c
palette = 1=#b45648
palette = 2=#6caa71
palette = 3=#c4ac62
palette = 4=#6d96b4
palette = 5=#bd7bcd
palette = 6=#7ccbcd
palette = 7=#dee5eb
palette = 8=#465c6d
palette = 9=#df6c5a
palette = 10=#79be7e
palette = 11=#e5c872
palette = 12=#67b5ed
palette = 13=#d389e5
palette = 14=#84dde0
palette = 15=#e5eff5
background-opacity = 0.95
background-blur = 20

font-family = Atkinson Hyperlegible Mono
font-size = 12
macos-option-as-alt = right
macos-titlebar-style = transparent
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
